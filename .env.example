# Use your Azure DevOps Services organization, project, and repository GUID.
AZURE_ORG_URL=https://dev.azure.com/your-organization
AZURE_PROJECT=your-project
AZURE_REPOSITORY_ID=your-repository-guid
# Azure identity GUID of the token owner; not a Microsoft Entra object ID.
AZURE_BOT_ID=your-dedicated-service-identity-guid
AZURE_AUTH_TYPE=pat
AZURE_TOKEN=
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
QUIZ_STATE_KEY=
LLM_PROVIDER=azure-openai
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=your-structured-output-deployment
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: process just one PR, otherwise all active PRs in the configured repo.
# PR_ID=123
# QUIZ_QUESTION_COUNT=3
# QUIZ_MAX_ATTEMPTS=3
# QUIZ_MAX_FILES=30
# QUIZ_MAX_CONTEXT_CHARS=80000
# Exact case-sensitive repo path prefixes, comma separated. No automatic exclusions.
# QUIZ_EXCLUDE_PREFIXES=/assets/,/package-lock.json
# Or use public OpenAI by setting LLM_PROVIDER=openai and these:
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
